+# KV cache dtypes the mm-prefix variant reads. An NVFP4 cache is read through
+# the variant's scale-factor tensors (kv_cache_sf).
+_MM_PREFIX_KV_CACHE_DTYPES = (
+    None,
+    "auto",
+    "float16",
+    "bfloat16",
+    "fp8",
+    "fp8_e4m3",
+    "nvfp4",
+)
+
